# HDDT Downloader for Windows
# Sao chép thành .env rồi điền giá trị. .env đã bị Git bỏ qua.
# run.cmd: tải API | parse-local.cmd: đọc XML có sẵn.

# 1. ĐĂNG NHẬP VÀ PHẠM VI ------------------------------------------------------
# Bắt buộc dùng tài khoản GDT. Chương trình tự lấy CAPTCHA, tự nhận diện
# và đăng nhập; token chỉ được tạo trong bộ nhớ phiên chạy.
GDT_USERNAME=
GDT_PASSWORD=
# Proxy tùy chọn cho máy chủ/VPN đang chặn IP nước ngoài.
# Ví dụ: PROXY_URL=http://127.0.0.1:8080
# Cũng nhận dạng host:port:username:password; nên tách PROXY_USERNAME/PROXY_PASSWORD
# trong .env để không làm lộ bí mật trong URL.
PROXY_URL=
PROXY_USERNAME=
PROXY_PASSWORD=
# purchase=hóa đơn nhà cung cấp xuất cho đơn vị đang tra cứu.
# sold=hóa đơn do đơn vị đang tra cứu phát hành; both=lấy cả hai nhóm.
INVOICE_DIRECTION=both
# Ngày lập hóa đơn, dạng dd/MM/yyyy.
FROM_DATE=01/09/2026
TO_DATE=30/09/2026
# true=lấy hóa đơn điện tử thông thường (nguồn query của GDT).
INCLUDE_REGULAR=true
# true=lấy hóa đơn khởi tạo từ máy tính tiền (nguồn sco-query của GDT).
INCLUDE_SCO=true
# true=gọi API relative/related để lấy chuỗi hóa đơn thay thế/điều chỉnh và
# thông tin liên quan (hóa đơn trạng thái 2-6); false=chỉ ghi thông tin hóa đơn
# gốc lấy từ danh sách, không tốn request liên quan.
FETCH_RELATED=true

# 2. ĐẦU RA --------------------------------------------------------------------
OUTPUT_DIR=output
OUTPUT_XLSX=HoaDonDienTu.xlsx
# true=ghi đè file Excel cùng tên.
OVERWRITE_OUTPUT=true
# true=mỗi lần chạy đều tải lại toàn bộ XML và ghi lại file cùng tên.
# false=dùng lại XML cùng tên đã có, chỉ tải các file còn thiếu.
REDOWNLOAD_XML=true
# Workbook .xlsx có sheet 'LinkTraCuu' dùng làm bảng tra link tra cứu: mở file
# Excel đã xuất, thêm/sửa MST + link trong sheet đó rồi trỏ biến này vào file.
# Để trống thì dùng bảng LinkTraCuu mặc định đi kèm chương trình.
LOOKUP_TABLE_XLSX=

# 3. MẠNG ----------------------------------------------------------------------
PAGE_SIZE=50
# Khoảng nghỉ cơ bản giữa hai lần gọi API, tính bằng mili giây.
REQUEST_DELAY_MS=600
# true=tự điều chỉnh khoảng nghỉ theo phản hồi máy chủ.
ADAPTIVE_THROTTLE=true
# Số lần thử lại cho lỗi mạng/HTTP 5xx. Riêng HTTP 429 (giới hạn tốc độ) được
# thử lại độc lập với giá trị này theo mốc backoff dài (15s→30s→...→600s, tối
# đa 12 lần), để một đợt rate-limit dài không làm dừng phiên tải giữa chừng.
MAX_RETRIES=4
HTTP_TIMEOUT_SECONDS=90
# Số kết nối tải XML chạy song song; 1=tải tuần tự như trước, tối đa 10.
XML_CONCURRENCY=2
# Trần kết nối khi cơ chế tự phục hồi tăng dần sau mỗi đợt HTTP 429.
XML_MAX_CONCURRENCY=3
# Giãn cách giữa hai request XML liên tiếp (mili giây), tự tăng 1.5 lần khi bị
# 429 và giảm về mức này sau 25 request thành công liên tiếp.
XML_REQUEST_INTERVAL_MS=800
# Để trống thì dùng User-Agent Edge/Chrome mặc định; điền giá trị khác nếu GDT
# yêu cầu đúng trình duyệt.
BROWSER_USER_AGENT=

# 4. LOG -----------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_TO_FILE=true
# true=in ra log nhóm header an toàn của mỗi request (không có token/mật khẩu)
# để chẩn đoán GDT từ chối header.
LOG_HTTP_PROFILE=false
# In tiến độ sau mỗi N hóa đơn.
PROGRESS_EVERY=1

# 5. PARSE XML LOCAL ------------------------------------------------------------
LOCAL_XML_DIR=
# auto=tự nhận diện theo thư mục purchase/sold hoặc tiền tố tên file.
# purchase/sold=ép toàn bộ XML trong LOCAL_XML_DIR về một loại.
LOCAL_DIRECTION=auto
LOCAL_OUTPUT_XLSX=HoaDonDienTu_Local.xlsx
