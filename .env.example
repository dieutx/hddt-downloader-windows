# HDDT Downloader for Windows
# Sao chép thành .env rồi điền giá trị. .env đã bị Git bỏ qua.
# run.cmd: tải API | parse-local.cmd: đọc XML có sẵn.

# 1. API VÀ PHẠM VI ------------------------------------------------------------
# Token thuần hoặc chuỗi bắt đầu bằng "Bearer ". Chỉ run.cmd cần token.
GDT_TOKEN=
# purchase=mua vào; sold=bán ra; both=cả hai.
INVOICE_DIRECTION=both
# Ngày lập hóa đơn, dạng dd/MM/yyyy.
FROM_DATE=01/09/2026
TO_DATE=30/09/2026
# Bật/tắt query thường và sco-query máy tính tiền.
INCLUDE_REGULAR=true
INCLUDE_SCO=true

# 2. ĐẦU RA --------------------------------------------------------------------
OUTPUT_DIR=output
OUTPUT_XLSX=HoaDonDienTu.xlsx
# true=ghi đè file Excel cùng tên.
OVERWRITE_OUTPUT=true
# true=luôn tải lại XML; false=tái sử dụng XML đã có.
REDOWNLOAD_XML=true

# 3. MẠNG ----------------------------------------------------------------------
PAGE_SIZE=50
# Khoảng nghỉ giữa request (ms). 600 ổn định; 500 có thể bị 429.
REQUEST_DELAY_MS=600
# Tự giảm tốc khi gặp 429 rồi phục hồi dần.
ADAPTIVE_THROTTLE=true
MAX_RETRIES=4
HTTP_TIMEOUT_SECONDS=90

# 4. LOG -----------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_TO_FILE=true
# In tiến độ sau mỗi N hóa đơn.
PROGRESS_EVERY=1

# 5. PARSE XML LOCAL ------------------------------------------------------------
LOCAL_XML_DIR=
# purchase hoặc sold.
LOCAL_DIRECTION=purchase
LOCAL_OUTPUT_XLSX=HoaDonDienTu_Local.xlsx
