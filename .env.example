# HDDT Downloader for Windows
# Sao chép thành .env rồi điền giá trị. .env đã bị Git bỏ qua.
# run.cmd: tải API | parse-local.cmd: đọc XML có sẵn.

# 1. API VÀ PHẠM VI ------------------------------------------------------------
# Token thuần hoặc chuỗi bắt đầu bằng "Bearer ". Chỉ run.cmd cần token.
GDT_TOKEN=
# purchase=hóa đơn nhà cung cấp xuất cho đơn vị đang tra cứu.
# sold=hóa đơn do đơn vị đang tra cứu phát hành; both=lấy cả hai nhóm.
INVOICE_DIRECTION=both
# Ngày lập hóa đơn, dạng dd/MM/yyyy.
FROM_DATE=01/09/2026
TO_DATE=30/09/2026
# true=lấy hóa đơn điện tử thông thường (nguồn query của GDT).
INCLUDE_REGULAR=true
# true=lấy hóa đơn khởi tạo từ máy tính tiền (nguồn sco-query của GDT).
INCLUDE_SCO=true

# 2. ĐẦU RA --------------------------------------------------------------------
OUTPUT_DIR=output
OUTPUT_XLSX=HoaDonDienTu.xlsx
# true=ghi đè file Excel cùng tên.
OVERWRITE_OUTPUT=true
# true=mỗi lần chạy đều tải lại toàn bộ XML và ghi lại file cùng tên.
# false=dùng lại XML cùng tên đã có, chỉ tải các file còn thiếu.
REDOWNLOAD_XML=true

# 3. MẠNG ----------------------------------------------------------------------
PAGE_SIZE=50
# Khoảng nghỉ cơ bản giữa hai lần gọi API, tính bằng mili giây.
REQUEST_DELAY_MS=600
# true=tự điều chỉnh khoảng nghỉ theo phản hồi máy chủ.
ADAPTIVE_THROTTLE=true
MAX_RETRIES=4
HTTP_TIMEOUT_SECONDS=90

# 4. LOG -----------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
LOG_TO_FILE=true
# In tiến độ sau mỗi N hóa đơn.
PROGRESS_EVERY=1

# 5. PARSE XML LOCAL ------------------------------------------------------------
LOCAL_XML_DIR=
# auto=tự nhận diện theo thư mục purchase/sold hoặc tiền tố tên file.
# purchase/sold=ép toàn bộ XML trong LOCAL_XML_DIR về một loại.
LOCAL_DIRECTION=auto
LOCAL_OUTPUT_XLSX=HoaDonDienTu_Local.xlsx
